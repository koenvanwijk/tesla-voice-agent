# Local AI
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Speech recognition
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Brev Secure Link/Tunnel can provide browser authentication, so this may stay empty.
# Set a value only if you want a second application-level bearer token.
VOICE_AGENT_TOKEN=

# GitHub Pages is allowed for testing a remote backend. Direct Brev use is same-origin.
ALLOWED_ORIGINS=https://koenvanwijk.github.io,http://localhost:8080,http://127.0.0.1:8080

# Serve frontend and API on the same port (recommended for Brev)
SERVE_FRONTEND=1
